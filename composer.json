{
    "name": "zasetsu/lookout",
    "type": "laravel-package",
    "description": "Self-hosted, Laravel-native observability package",
    "license": "MIT",
    "authors": [
        {
            "name": "Zasetsu"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-pdo_sqlite": "*",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.8|^4.4",
        "pestphp/pest-plugin-laravel": "^3.2|^4.1",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Zasetsu\\Lookout\\": "src/",
            "Zasetsu\\Lookout\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zasetsu\\Lookout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:parallel": "vendor/bin/pest --parallel",
        "lint": "vendor/bin/pint --test src/ tests/ config/ database/ routes/",
        "lint:fix": "vendor/bin/pint src/ tests/ config/ database/ routes/",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M src/ tests/ --level=5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zasetsu\\Lookout\\LookoutServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
